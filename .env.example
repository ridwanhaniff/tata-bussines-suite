# ════════════════════════════════════════════════
# Tata Business Suite — Environment Variables
# Copy ke .env, JANGAN commit file .env ke Git
# ════════════════════════════════════════════════
# Deployment Target: Railway
# ════════════════════════════════════════════════

# ─── WAJIB — Core ────────────────────────────────────────────
NODE_ENV=production

# URL aplikasi Railway kamu (isi setelah deploy pertama)
# Format: https://<project-name>.up.railway.app
APP_URL=https://tata-bussines-suite-production.up.railway.app

# Supabase (WAJIB)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key_here

# PostgreSQL untuk session store (WAJIB — cegah logout saat restart)
# Supabase: Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Session secret (min 32 karakter random) — WAJIB DIGANTI!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti_dengan_random_string_32_karakter_minimal_ya

# ─── AI / NLP (WAJIB salah satu) ─────────────────────────────
# Pilihan 1: Google Gemini API (Direkomendasikan — gratis & cepat)
# Dapatkan key di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash   # opsional, default: gemini-2.5-flash

# Pilihan 2: OpenRouter (fallback jika Gemini tidak tersedia)
# Daftar & dapatkan key gratis di: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ─── OPSIONAL — Voice Transcription ──────────────────────────
# Hugging Face Token (untuk transkripsi voice note via Whisper)
# Dapatkan di: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxx

# ─── OPSIONAL — Backup Database ───────────────────────────────
# Jika ingin backup otomatis ke Hugging Face Dataset Repo:
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxx   (sama seperti di atas)
# HF_BACKUP_BUCKET=username/tata-suite-storage

# ─── OPSIONAL — OCR Struk (Google Cloud Vision) ───────────────
# Metode 1: Paste isi JSON key langsung (DIREKOMENDASIKAN untuk Railway)
# Download service account key dari Google Cloud Console, paste seluruh isi JSON di sini:
# GOOGLE_VISION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Metode 2: Path file (hanya untuk local development)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-vision-key.json

# ─── OPSIONAL — Info Pembayaran ───────────────────────────────
# Jika tidak diisi, fallback ke default (BCA a.n. HANAN RIDWAN HANIF)
# PAYMENT_BANK=BCA
# PAYMENT_ACCOUNT=8670662536
# PAYMENT_NAME=HANAN RIDWAN HANIF

# ─── OPSIONAL — Admin & Notifikasi ──────────────────────────
# Nomor WA admin untuk menerima notifikasi error darurat (format: 62812xxxx@c.us)
# ADMIN_WA_NUMBER=62812xxxxxxxxx@c.us

# ─── OPSIONAL — Database Pool ────────────────────────────────
# DB_POOL_MAX=20   # default: 20, min: 2, max: 50

# ─── CATATAN RAILWAY ─────────────────────────────────────────
# PORT: Railway inject otomatis — JANGAN diset manual di sini
# NODE_OPTIONS sudah diset di Dockerfile (--max-old-space-size=450)
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true sudah diset di Dockerfile
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium sudah diset di Dockerfile
